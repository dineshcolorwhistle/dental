<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reminder: {{title}}</title>
  <style>
    body { margin: 0; padding: 0; background-color: #f0f6fb; font-family: 'Segoe UI', Arial, sans-serif; }
    .container { max-width: 560px; margin: 0 auto; padding: 40px 20px; }
    .card { background: #ffffff; border-radius: 16px; padding: 40px 32px; box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
    .logo-wrap { text-align: center; margin-bottom: 24px; }
    .logo { display: inline-block; width: 56px; height: 56px; background: linear-gradient(135deg, #6FAED9, #A9CFE8); border-radius: 14px; line-height: 56px; text-align: center; color: #fff; font-size: 24px; font-weight: 700; }
    h1 { color: #1e293b; font-size: 22px; font-weight: 700; margin: 0 0 8px; text-align: center; }
    .subtitle { color: #64748b; font-size: 14px; text-align: center; margin: 0 0 28px; line-height: 1.5; }
    .info-box { background: #f0f6fb; border-radius: 10px; padding: 16px 20px; margin-bottom: 28px; }
    .note { color: #94a3b8; font-size: 12px; text-align: center; line-height: 1.6; margin-top: 24px; }
    .footer { text-align: center; padding: 24px 0; color: #94a3b8; font-size: 11px; }
    .divider { height: 1px; background: #e2e8f0; margin: 24px 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="logo-wrap">
        <div class="logo">D</div>
      </div>

      <h1>⏰ Upcoming Reminder</h1>
      <p class="subtitle">
        Hi <strong>{{userName}}</strong>, you have an upcoming reminder from <strong>{{tenantName}}</strong>.
      </p>

      <div class="info-box">
        <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse;">
          <tr>
            <td style="color: #64748b; font-size: 13px; padding: 6px 0;">Title</td>
            <td style="color: #1e293b; font-size: 13px; font-weight: 600; text-align: right; padding: 6px 0;">{{title}}</td>
          </tr>
          <tr>
            <td style="color: #64748b; font-size: 13px; padding: 6px 0;">Time</td>
            <td style="color: #1e293b; font-size: 13px; font-weight: 600; text-align: right; padding: 6px 0;">{{reminderTime}}</td>
          </tr>
          <tr>
            <td style="color: #64748b; font-size: 13px; padding: 6px 0;">Priority</td>
            <td style="color: #1e293b; font-size: 13px; font-weight: 600; text-align: right; padding: 6px 0;">{{priority}}</td>
          </tr>
          <tr>
            <td style="color: #64748b; font-size: 13px; padding: 6px 0;">Recurrence</td>
            <td style="color: #1e293b; font-size: 13px; font-weight: 600; text-align: right; padding: 6px 0;">{{recurrence}}</td>
          </tr>
          {{#if category}}
          <tr>
            <td style="color: #64748b; font-size: 13px; padding: 6px 0;">Category</td>
            <td style="color: #1e293b; font-size: 13px; font-weight: 600; text-align: right; padding: 6px 0;">{{category}}</td>
          </tr>
          {{/if}}
        </table>
      </div>

      {{#if description}}
      <div style="background: #fef9c3; border-radius: 10px; padding: 14px 18px; margin-bottom: 20px;">
        <p style="margin: 0; color: #854d0e; font-size: 13px; line-height: 1.5;">
          <strong>Details:</strong> {{description}}
        </p>
      </div>
      {{/if}}

      <div class="divider"></div>

      <p class="note">
        This notification was sent 2 hours before the scheduled time.<br>
        — {{tenantName}} Team
      </p>
    </div>

    <div class="footer">
      &copy; {{tenantName}} · Dental Lab Management
    </div>
  </div>
</body>
</html>
